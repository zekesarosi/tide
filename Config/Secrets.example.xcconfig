// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.

TIDE_CONTACT = you@yourdomain.com
TIDE_BUNDLE_ID = com.yourcompany.tideforecast
DEVELOPMENT_TEAM = ABCDE12345

// Development-only keys (see the note in App.xcconfig).
OPEN_METEO_API_KEY =
UK_ADMIRALTY_KEY =

// San Francisco Bay live layer (optional): the release asset published by
// .github/workflows/sfbay-live.yml in your fork. "//" starts a comment in
// .xcconfig files, so the slashes are spelled with $(SLASH).
SLASH = /
// TIDE_BAY_LIVE_URL = https:$(SLASH)$(SLASH)github.com/OWNER/REPO/releases/download/sfbay-live/sfbay.residual.deflate
